# Copy this file to .env and fill in ONE option.
# .env is in .gitignore. Never commit a real key, and never paste one into a chat.

# ---------------------------------------------------------------------------
# Option A: Gemini through Google's free tier (no card needed)
# ---------------------------------------------------------------------------
# Get a key:        https://aistudio.google.com/apikey
# See your limits:  https://aistudio.google.com/rate-limit
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# A free tier caps calls per minute and per day. LLM_RPM spaces the calls out so the
# per-minute cap is not hit. Set it a little under the "requests per minute" on your
# limits page. 10 is a cautious starting value, not Google's number.
LLM_RPM=10

# ---------------------------------------------------------------------------
# Option B: any other OpenAI-compatible API (OpenAI, Groq, OpenRouter, ...)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=<the model id your provider serves>
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# Send no temperature at all with LLM_TEMPERATURE=none (some models reject it):
# LLM_TEMPERATURE=0

# ---------------------------------------------------------------------------
# Option C: a local model with Ollama (free, no key, slow on a laptop)
# ---------------------------------------------------------------------------
# Ollama's default context is 4,096 tokens and the prompt here is close to that.
# Start the server with more room first:   OLLAMA_CONTEXT_LENGTH=16384 ollama serve
# LLM_PROVIDER=ollama
# LLM_MODEL=<a model you have pulled>

# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------
# Output limit per call. The default is 2000 for Gemini and 600 otherwise.
# LLM_MAX_TOKENS=
